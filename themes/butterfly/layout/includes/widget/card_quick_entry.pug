//- 快捷入口卡 —— 把原先挂在首屏的两个行动按钮（浏览全部文章 / 下载 EFI）
//- 收进侧栏，做成每个页面都能点到的常驻入口。
//- 图标沿用站内线性语言：stroke 1.8 / currentColor / 24 网格（与导航、右下浮标一致）
-
  const RJ_QE_ICONS = {
    bolt: '<path d="M13.2 3.4 5.6 13.4h5.4l-.8 7.2 7.6-10h-5.4z"/>',
    archive: '<path d="M4.2 8.4h15.6"/><path d="m5.6 8.4 1.1 9.9a1.7 1.7 0 0 0 1.7 1.5h7.2a1.7 1.7 0 0 0 1.7-1.5l1.1-9.9"/><path d="M9.4 8.4V5.6a2.6 2.6 0 0 1 2.6-2.6 2.6 2.6 0 0 1 2.6 2.6v2.8"/>',
    download: '<path d="M12 4.2v10.4"/><path d="m7.7 10.6 4.3 4.3 4.3-4.3"/><path d="M4.6 17.4v1.5a1 1 0 0 0 1 1h12.8a1 1 0 0 0 1-1v-1.5"/>',
    arrow: '<path d="M9.6 6.2 15.4 12l-5.8 5.8"/>',
    external: '<path d="M14.2 4.8h5v5"/><path d="M19.2 4.8 11.4 12.6"/><path d="M18.4 14.2v3.9a1.4 1.4 0 0 1-1.4 1.4H6.3a1.4 1.4 0 0 1-1.4-1.4V7.3a1.4 1.4 0 0 1 1.4-1.4h3.9"/>'
  }
  const RJ_QE_SVG = (name, cls) => `<svg class="rj-qe-svg${cls ? ' ' + cls : ''}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${RJ_QE_ICONS[name] || ''}</svg>`
  const rjQePostCount = site.posts.length
.card-widget.card-quick-entry#rj-quick-entry
  .item-headline
    != RJ_QE_SVG('bolt', 'rj-qe-hd')
    span 快捷入口
  nav.rj-qe-list(aria-label="快捷入口")
    a.rj-qe-item(href=url_for('/archives/'))
      span.rj-qe-badge
        != RJ_QE_SVG('archive')
      span.rj-qe-body
        span.rj-qe-t 浏览全部文章
        span.rj-qe-s= `${rjQePostCount} 篇文章 · 按时间归档`
      span.rj-qe-go
        != RJ_QE_SVG('arrow')
    a.rj-qe-item.is-ext(href='https://github.com/RockJesus/Alienware-Hackintosh' target='_blank' rel='noopener noreferrer')
      span.rj-qe-badge
        != RJ_QE_SVG('download')
      span.rj-qe-body
        span.rj-qe-t 下载 EFI
        span.rj-qe-s Alienware 黑苹果合集
      span.rj-qe-go
        != RJ_QE_SVG('external')
